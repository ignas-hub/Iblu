[Unit]
Description=iblu-keeper evening day card — here's what I think you did today
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ignas
WorkingDirectory=/home/ignas/iblu
EnvironmentFile=/home/ignas/iblu/.env
ExecStart=/home/ignas/iblu/.venv/bin/python -m iblu_keeper.jobs.daycard
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
