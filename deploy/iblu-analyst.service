[Unit]
Description=iblu-keeper analyst pass — reconstruct the day into blocks
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ignas
WorkingDirectory=/home/ignas/iblu
EnvironmentFile=/home/ignas/iblu/.env
ExecStart=/home/ignas/iblu/.venv/bin/python -m iblu_keeper.jobs.analyst
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
