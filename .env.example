# =====================================================================
# iblu-keeper — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =====================================================================

# ---------------------------------------------------------------------
# MCP SERVER
# ---------------------------------------------------------------------
# Host/port the FastMCP HTTP server binds to (behind Caddy/nginx).
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Bearer token Claude must send to use the MCP server.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=change-me-to-a-long-random-string

# DRY_RUN=true  -> no Google calls; Chat/Gmail/Calendar return mock data.
# Leave true until the Google service-account access has been validated.
DRY_RUN=true

# ---------------------------------------------------------------------
# GOOGLE OAUTH — single-user access (Gmail / Calendar / Chat)
# ---------------------------------------------------------------------
# The assistant accesses ONLY your account via an OAuth refresh token.
# No service account, no domain-wide delegation. Use the OAuth client you
# created in Google Cloud (the same one can serve the dashboard login).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Where the refresh token is stored after you run scripts/connect_google.py.
GOOGLE_OAUTH_TOKEN_FILE=data/token.json
# Informational only (the token determines the actual account).
GOOGLE_USER_EMAIL=ignas@blanklabel.team

# ---------------------------------------------------------------------
# STREAMLIT DASHBOARD — Google OAuth login (restrict to one account)
# ---------------------------------------------------------------------
DASHBOARD_OAUTH_CLIENT_ID=
DASHBOARD_OAUTH_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud console.
DASHBOARD_OAUTH_REDIRECT_URI=https://keeper.iblugames.com/
# Only this Google account may log into the dashboard.
DASHBOARD_ALLOWED_EMAIL=ignas@blanklabel.team
# Random string used to sign the dashboard session cookie.
DASHBOARD_COOKIE_SECRET=change-me-to-another-long-random-string
# Where the dashboard reaches the MCP server (for health/status checks).
DASHBOARD_MCP_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------
# PHASE 2 — POSTGRES (declared now, unused in Phase 1)
# ---------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://iblu:password@localhost:5432/iblu_keeper

# ----- Phase 2: recording v1 (docs/plans/2026-09-14-recording-v1.md) -----
# Postgres. On the server this is the dedicated `iblu-db` Docker container
# (postgres:16-alpine, volume iblu-pgdata, bound to 127.0.0.1 only).
DATABASE_URL=postgresql://iblu:CHANGEME@127.0.0.1:5432/iblu_keeper

# Ping composer. Create the key with a monthly spend cap; never commit it.
ANTHROPIC_API_KEY=
IBLU_LLM_MODEL=claude-sonnet-5
# The model that CHECKS the work rather than doing it: the analyst's judge and
# the sense-check pass. Both run twice a day and decide what the record says he
# did, so a mistake there is silent and compounds. Worth the better model.
IBLU_CHECK_MODEL=claude-opus-5

# Scheduling. Storage is UTC; every scheduling decision uses this zone.
IBLU_TIMEZONE=Europe/Zagreb

# "Secretary" Google Chat space: webhook posts the card, space id reads replies.
# The webhook URL is a secret (it can post as the app); the space id is not.
#
# QUOTE the webhook URL. It contains `&` between the key and token params;
# unquoted, `set -a; . ./.env` splits the line and silently drops everything
# after the ampersand, leaving an unauthenticated URL that 401s at send time.
SECRETARY_WEBHOOK_URL='https://chat.googleapis.com/v1/spaces/AAA.../messages?key=...&token=...'
SECRETARY_SPACE=spaces/AAA...

# Signs the /q/<token> tap links. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PING_SIGNING_SECRET=

# Pings stay OFF until the Secretary space exists and A7 passes.
PING_ENABLED=false
PING_DAYS=MON,TUE,WED,THU,FRI
PING_MIDDAY=12:30-14:00
PING_EVENING=17:00-18:30

# ----- GitHub (read-only) -----
# Lets the `repo` tool read repositories that are not on this box.
# Fine-grained PAT, All repositories, Contents: Read-only (+ Metadata).
# Quote it — tokens are safe, but the habit prevents the `&` class of bug.
GITHUB_TOKEN=''
GITHUB_OWNER=ignas-hub
# Organisation repositories need their OWN fine-grained token — a PAT is scoped
# to one resource owner, so a personal token cannot see an org's repos. Add one
# per organisation; IBLU tries each until one can see the repository.
GITHUB_TOKEN_2=''
GITHUB_TOKEN_3=''

# ----- Multi-account (week 2) -----
# Each Google Workspace needs its OWN Cloud project + Internal OAuth client:
# IBLU's consent screen is Internal to blanklabel.team, so the other accounts
# cannot authorise it. Authorize each once with:
#     python scripts/connect_google.py --account choco
GOOGLE_ACCOUNTS=blt,choco,deadlift
GOOGLE_ACCOUNT_CHOCO_EMAIL=ignacio@chocoagency.com
GOOGLE_ACCOUNT_CHOCO_CLIENT_ID=
GOOGLE_ACCOUNT_CHOCO_CLIENT_SECRET=
GOOGLE_ACCOUNT_DEADLIFT_EMAIL=admin@deadlift.io
GOOGLE_ACCOUNT_DEADLIFT_CLIENT_ID=
GOOGLE_ACCOUNT_DEADLIFT_CLIENT_SECRET=

# ----- Intent calendars beyond each account's primary (analyst) -----
# The analyst already reads every account above's PRIMARY calendar as
# "intended day". This is for calendars that are not anyone's primary but
# still say something about intent — a shared family calendar, a personal
# Gmail calendar — read through whichever account already has access, no new
# OAuth scope needed.
#
# Format: venture:calendar_id[|account_alias], comma-separated. `|`, not `@`,
# separates the account — a calendar id already contains `@`
# (...@group.calendar.google.com). Omit `|account` to default to the primary
# account (blt).
#
# CAUTION: use `family:`, not `personal:`, for a shared family calendar or a
# personal Gmail calendar. `personal` means Ignas's own tooling & infra —
# work — and `family` means family & personal life; conflating the two is
# exactly the HANDOFF §23 mistake repeating itself.
INTENT_CALENDARS=family:family17712020332388721989@group.calendar.google.com|blt,family:ignas.ignas@gmail.com|blt

# ----- Slack workspaces (week 3) -----
# `search.messages` only works with a USER token (xoxp-) — a bot token cannot
# see it — so each workspace needs its own signed-in user's token, created
# via a Slack app installed to that workspace with the `search:read` user
# scope. One token (+ optional label + venture default) per alias.
SLACK_WORKSPACES=blt,deadlift
SLACK_TOKEN_BLT=
SLACK_LABEL_BLT=
SLACK_VENTURE_BLT=blt
SLACK_TOKEN_DEADLIFT=
SLACK_LABEL_DEADLIFT=
SLACK_VENTURE_DEADLIFT=deadlift

# The mirror calendar holding reconstructed `blocks` — ONE calendar on
# blanklabel.team covering every venture. Create it as a NEW calendar (never the
# primary): it will contain Choco and Deadlift work. Find the id under
# Calendar settings > the calendar > Integrate calendar > Calendar ID.
SECRETARY_CALENDAR_ID=
